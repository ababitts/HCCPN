# Step 1:Estimate response pattern correlations and generate the dendrogram
#pairwise.complete.obs will eliminate variables with missingness between participants only
#in the dataset, participants are rows and variables are columns so need to transpose to estimate response pattern correlations
cor_matrix1.1 <- abs(cor(t(Aim1_data), use = "pairwise.complete.obs", method = "spearman")) 

# Convert correlation matrix to distance matrix
distance_matrix1.1 <- as.dist(1 - cor_matrix1.1)

# Perform hierarchical clustering using Ward
hc_complete1.1 <- hclust(distance_matrix1.1, method = "ward.D2")

# Plot Dendrogram
plot(hc_complete1.1, 
     main = "Hierarchical Correlation Clustering Dendrogram", 
     xlab = "Participants",
     ylab = "Cluster Merger Height",
     sub = "", 
     cex = 0.9,
     labels = FALSE)
###End of correlation

#Step 2: Identifying number of clusters using partitioning methods
###Silhouette score
# Try different numbers (k) of clusters
k_values1.1 <- 2:10

# Compute average silhouette width for each cluster (k)
avg_sil1.1 <- sapply(k_values1.1, function(k) {
  cluster_assignments1.1 <- cutree(hc_complete1.1, k)
  sil1.1 <- silhouette(cluster_assignments1.1, distance_matrix1.1)
  mean(sil1.1[, 3]) 
})

avg_sil1.1 ## provides quantitative values for each cluster set

plot(k_values1.1, avg_sil1.1, type = "b", pch = 19,
     xlab = "Number of Clusters",
     ylab = "Average Silhouette Width",
     main = "Silhouette Score Analysis")
best_k_SS1.1 <- k_values1.1[which.max(avg_sil1.1)]
cat("Optimal number of clusters from Silhouette Score:", best_k_SS1.1, "\n")
abline(v = best_k_SS1.1, col = "red", lty = 2) 

###Davies-Bouldin Index
#estimate DB index for number of K clusters
K_max1.1 <- 10
db_values1.1 <- numeric(K_max1.1)

# Compute DB index for each k
for (k in 2:K_max1.1) {  
  clusters1.1 <- cutree(hc_complete1.1, k)
  db_values1.1[k] <- intCriteria(traj = as.matrix(distance_matrix1.1), 
                                 part = clusters1.1, crit = "Davies_Bouldin")$davies_bouldin
}
db_values1.1 ###provides quantitative values for each cluster set. not defined for a 1-cluster solution

# Plot DB index
plot(2:K_max1.1, db_values1.1[2:K_max1.1], type = "b",
     xlab = "Number of clusters", 
     ylab = "DBI estimate",
     main = "Davies-Bouldin Index Analysis")

valid_k <- 2:K_max1.1
optimal_k_DB1.1 <- valid_k[
  which.min(db_values1.1[valid_k])
]
cat("Optimal number of clusters according to DB index:", optimal_k_DB1.1, "\n")
abline(v = optimal_k_DB1.1, col = "red", lty = 2) 

###Calinski-Harabasz index
#estimate CH index for each K cluster
ch_values1.1 <- numeric(K_max1.1)

# Compute CH index for each k
for (k in 2:K_max1.1) {  # CH index not defined for k=1
  clusters1.1 <- cutree(hc_complete1.1, k)
  ch_values1.1[k] <- intCriteria(traj = as.matrix(distance_matrix1.1), 
                                 part = clusters1.1, crit = "Calinski_Harabasz")$calinski_harabasz
}
ch_values1.1 ###provides quantitative values for each cluster set. not defined for a 1-cluster solution

# Plot CH index
plot(2:K_max1.1, ch_values1.1[2:K_max1.1], type = "b",
     xlab = "Number of clusters",
     ylab = "CHI estimate",
     main = "Calinski-Harabasz Index Analysis")

optimal_k_CH1.1 <- which.max(ch_values1.1)
cat("Optimal number of clusters according to CH index:", optimal_k_CH1.1, "\n")
abline(v = optimal_k_CH1.1, col = "red", lty = 2) 

###ELBOW METHOD
# Function to compute total within-cluster sum of squares
wss_hclust1.1 <- function(hc_complete1.1, distance_matrix1.1, k) {
  clusters <- cutree(hc_complete1.1, k)
  total_wss <- 0
  dist_matrix <- as.matrix(distance_matrix1.1)
  for (i in 1:k) {
    members <- which(clusters == i)
    if (length(members) > 1) {
      cluster_dist <- dist_matrix[members, members]
      total_wss <- total_wss + sum(cluster_dist^2) / (2 * length(members))
    }
  }
  return(total_wss)
}

# Compute for different k values
wss_values1.1 <- sapply(k_values1.1, function(k) {
  wss_hclust1.1(hc_complete1.1, distance_matrix1.1, k)
})
wss_values1.1 ###provides quantitative values for each cluster set. starts at 2 clusters

# Plot elbow curve
plot(k_values1.1, wss_values1.1, type = "b", pch = 19,
     xlab = "Number of clusters",
     ylab = "Total Within-Cluster Sum of Squares",
     main = "Elbow Method Analysis")
###determined by the point where there is a bend in the curve (when the increase in the # of clusters does not change total WSS as much)
abline(v = 5, col = "red", lty = 2) 

