###Cluster 1 networks using the correlation matrices###########
# Set threshold to p<0.05 for Network graphs (unweighted)
alpha <- 0.05
# Threshold the correlation matrix (keep both + and - values above threshold)
pcor_mat1.1_uwp <- pcor_mat1.1
pcor_mat1.1_uwp[p_mat1.1 >= alpha] <- 0
diag(pcor_mat1.1_uwp) <- 0 #converts diagonal correlations to 0 to be removed from the network
pcor_unweighted1.1_uwp <- ifelse(pcor_mat1.1_uwp != 0, 1, 0)  # any non-zero value becomes 1 for unweighted edges in network
##generate the graph matrix
g1.1_uwp <- graph_from_adjacency_matrix(pcor_unweighted1.1_uwp,
                                        mode = "undirected",
                                        weighted = NULL,
                                        diag = FALSE)

# Degree centrality (unweighted)
degree_centrality1.1_uwp <- degree(g1.1_uwp, mode = "all", loops = FALSE) 

# Normalize to [0,1]
norm_degree1.1_uwp <- (degree_centrality1.1_uwp) /
  (max(degree_centrality1.1_uwp))

# Rank in descending order (1 = highest degree)
rank_degree1.1_uwp <- rank(-degree_centrality1.1_uwp)

# Combine and view
degree_table1.1_uwp <- data.frame(
  Degree = degree_centrality1.1_uwp,
  Normalized = round(norm_degree1.1_uwp, 3),
  Rank = rank_degree1.1_uwp
)
# Order by rank
degree_table1.1_uwp <- degree_table1.1_uwp[order(degree_table1.1_uwp$Rank), ]

print(degree_table1.1_uwp)

###visualize Degree in figure
degree_df1.1 <- data.frame(
  Node = names(degree_centrality1.1_uwp),
  Degree = degree_centrality1.1_uwp
)

degree_df1.1 <- degree_df1.1[order(degree_df1.1$Degree), ]

ggplot(degree_df1.1, aes(x = reorder(Node, Degree), y = Degree)) +
  geom_segment(aes(xend = Node, yend = 0), linewidth = 0.8) +
  geom_point(size = 3) +
  coord_flip() +
  scale_y_continuous(
    breaks = 0:5,
    limits = c(0, 5)
  ) +
  labs(
    title = "Cluster 1",
    x = "",
    y = "Degree"
  ) +
  theme_minimal()+
  theme(plot.title=element_text(size=20, hjust = 0.25),
        axis.text.y = element_text(size = 12))

